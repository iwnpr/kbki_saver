{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Expressions", "db_lib", "cache_lib", "qbch_db_saver_sdc" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Error",
        "Microsoft.AspNetCore": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/qbch_db_saver-.log",
          "rollingInterval": "Day",
          "encoding": "System.Text.Encoding::UTF8",
          "Formatter": {
            "Type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "Template": "{ {@t, @l, @mt, @m, @x, ..@p} }\n"
          }
        }
      },
      {
        "Name": "Console",
        "Args": {
          "encoding": "System.Text.Encoding::UTF8",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "Formatter": {
            "Type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "Template": "{ {@t, @l, @mt, @m, @x, ..@p} }\n"
          }
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DataBase": "Server=10.10.100.84; Port=5288; Database=qbch; Include Error Detail=True; Pooling=false; Timeout=300; CommandTimeout=300; User Id=nadmin; Password=48Nadmin@;",
    "Redis": "10.10.100.84:6379,user=bot,password=ThaaX9aich4o"
  },
  "Kafka": {
    "bootstrapservers": "10.10.100.71:9092",
    "groupid": "qbch_", // айди группы
    "topic": "ErrorTopic", // топик в кафке
    "errortopic": "ErrorTopic",
    "iserrorapp": true
  },
