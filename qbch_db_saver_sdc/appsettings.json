{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Expressions", "db_lib", "cache_lib", "qbch_db_saver_sdc" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Microsoft.AspNetCore": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/qbch_db_saver-.log",
          "restrictedToMinimumLevel": "Error",
          "rollingInterval": "Day",
          "encoding": "System.Text.Encoding::UTF8",
          "Formatter": {
            "Type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "Template": "{ {@t, @l, @mt, @m, @x, ..@p} }\n"
          }
        }
      },
      {
        "Name": "Console",
        "restrictedToMinimumLevel": "Information",
        "Args": {
          "encoding": "System.Text.Encoding::UTF8",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "Formatter": {
            "Type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "Template": "{ {@t, @l, @m ..@p} }\n"
          }
        }
      }
      ,
      {
        "Name": "Elasticsearch",
        "Args": {
          "restrictedToMinimumLevel": "Warning",
          "bootstrapMethod": "Silent",
          "nodes": [ "http://10.10.100.243:9200" ],
          "username": "elastic",
          "password": "qaz-xsw1",
          "dataStream": "AppLogs"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DataBase": "Server=10.10.100.84; Port=6288; CommandTimeout=10000; Database=qbch; User Id=nadmin; Password=48Nadmin@; Include Error Detail=True; Pooling=True; Maximum Pool Size=16; ",
    //"DataBase": "Server=localhost; Port=6288; CommandTimeout=10000; Database=qbch; User Id=nadmin; Password=48Nadmin@; Include Error Detail=True; Pooling=True; Maximum Pool Size=16; ",
    "Redis": "10.10.100.84:6379,user=bot,password=ThaaX9aich4o"
  },
  "App": {
    "IsErrorApp": false, // Приложение для обработки топика с ошибками
    "ErrorRetryIterations": 5, // Количество попыток обработки ошибок
    "ErrorRetryDelayMs": 1000, // Задержка перед повторной попыткой обработки ошибки
    "ParallelConsumers": 10 // Кол-во партиций
  },
  "ElasticApm": {
    "username": "elastic",
    "password": "qaz-xsw1",
    "LogLevel": "Warning",
    "ServerUrls": "http://10.10.100.243:8200", //Set custom APM Server URL (default: http://localhost:8200)
    "ServiceName": "qbch_saver", //allowed characters: a-z, A-Z, 0-9, -, _, and space. Default is the entry assembly of the application
    "Environment": "dev" // Set the service environment
  },
  "Kafka": {
    "BootstrapServers": "10.10.100.71:9092",
    "GroupId": "QBCH_", // АЙДИ ГРУППЫ
    "Topic": "RedisMessagesTopicv2", // ТОПИК В КАФКЕ
    "ErrorTopic": "ErrorTopicv2", // Топик с ошибками 
    "EventTopic": null // ТОПИК В КАФКЕ    
  },
  "RedisCache": {
    "DBIndex": 0, // Default 0
    "RequestIdUniqueDays": 1, // Default 1
    "DlRequestExpirationMin": 480, // 8 ЧАСОВ ДО ИСПАРЕНИЯ КЛЮЧА В РЕДИСЕ ПОСЛЕ ЗАПИСИ В БД
    "QBCHRequestExpirationMin": 1, // 1 МИНУТА ДО ИСПАРЕНИЯ КЛЮЧА В РЕДИСЕ ПОСЛЕ ЗАПИСИ В БД
    "DlAnswerExpirationMin": 1, // 1 МИНУТА ДО ИСПАРЕНИЯ КЛЮЧА В РЕДИСЕ ПОСЛЕ ЗАПИСИ В БД
    "DlPutExpirationMin": 480, // 8 ЧАСОВ ДО ИСПАРЕНИЯ КЛЮЧА В РЕДИСЕ ПОСЛЕ ЗАПИСИ В БД
    "DlPutAnswerExpirationMin": 1 // 1 МИНУТА ДО ИСПАРЕНИЯ КЛЮЧА В РЕДИСЕ ПОСЛЕ ЗАПИСИ В БД
