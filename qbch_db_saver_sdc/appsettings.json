{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Expressions",
      "Elastic.Serilog.Sinks"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Debug",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Debug",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "restrictedToMinimumLevel": "Debug",
          "path": "logs/qbch.saver-.log",
          "rollingInterval": "Day",
          "encoding": "System.Text.Encoding::UTF8",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "restrictedToMinimumLevel": "Debug",
          "nodes": [ "http://monitoring.rs-cb.ru:9200" ],
          "dataStream": "logs-qbch.saver-preprod",
          "bootstrapMethod": "Silent",
          "apiKey": "ZVk5U3E1MEJLMTBHZEtkdnBTV086TEhyT2VDTnh2MVZ0VUp6V3hGdEVpdw==",
          "includeHost": true,
          "includeProcess": true,
          "includeActivity": true
        }
      }
    ]
  },
  "Database": {
    "Schema": "qbchv2",
    "SchemaSecondary": "qbchv3"
  },
  "ConnectionStrings": {
    "DataBase": "Server=10.50.9.88; Port=5432; Database=bureauQBCH; Include Error Detail=True; User Id=wwwBot; Password=123456;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=16;No Reset On Close=true;CommandTimeout=50;Timeout=1",
    "DataBaseSecondary": "Server=10.50.9.88; Port=5432; Database=bureauQBCH; Include Error Detail=True; User Id=wwwBot; Password=123456;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=16;No Reset On Close=true;CommandTimeout=50;Timeout=1",
    "Redis": "10.50.9.35:6379,user=bot,password=eexeeNg8iViegh,connectRetry=2,abortConnect=false"
  },
  "App": {
    "IsErrorApp": false, // Приложение для обработки топика с ошибками
    "ErrorRetryIterations": 5, // Количество попыток обработки ошибок
    "ErrorRetryDelayMs": 1000, // Задержка перед повторной попыткой обработки ошибки
    "ParallelConsumers": 10 // Кол-во партиций
  },
  "Kafka": {
    "BootstrapServers": "kafkapp.bureau.internal:9092",
    "GroupId": "QBCH_", // АЙДИ ГРУППЫ
    "Topic": "QBCHMessagesTopic_V3_206", // ТОПИК В КАФКЕ
    "ErrorTopic": "QBCHErrorTopic_v3", // Топик с ошибками
    "DlqTopic": "QBCHDlqTopic"
  },
  "RedisCache": {
    "DBIndex": 0, // Default 0
    "RequestIdUniqueDays": 480, // Default 1
    "DlRequestExpirationMin": 480, // 8 ЧАСОВ ДО ИСПАРЕНИЯ КЛЮЧА В РЕДИСЕ ПОСЛЕ ЗАПИСИ В БД
    "QBCHRequestExpirationMin": 480, // 1 МИНУТА ДО ИСПАРЕНИЯ КЛЮЧА В РЕДИСЕ ПОСЛЕ ЗАПИСИ В БД
    "DlAnswerExpirationMin": 480, // 1 МИНУТА ДО ИСПАРЕНИЯ КЛЮЧА В РЕДИСЕ ПОСЛЕ ЗАПИСИ В БД
    "DlPutExpirationMin": 480, // 8 ЧАСОВ ДО ИСПАРЕНИЯ КЛЮЧА В РЕДИСЕ ПОСЛЕ ЗАПИСИ В БД
    "DlPutAnswerExpirationMin": 480, // 1 МИНУТА ДО ИСПАРЕНИЯ КЛЮЧА В РЕДИСЕ ПОСЛЕ ЗАПИСИ В БД
    "DbStateExpirationMin": 480 // TTL маркера {key}:db_state (дедуп при повторной обработке). Должен переживать исходные данные ключа. По умолчанию = DlRequestExpirationMin
  },
